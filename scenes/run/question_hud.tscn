[gd_scene load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/ui/question_hud.gd" id="1_hud"]
[ext_resource type="Script" path="res://scripts/ui/phase_banner.gd" id="2_phase"]
[ext_resource type="Script" path="res://scripts/ui/shield_indicator.gd" id="3_shield"]
[ext_resource type="Script" path="res://scripts/ui/judgement_banner.gd" id="4_judgement"]
[ext_resource type="Script" path="res://scripts/ui/question_panel.gd" id="5_question"]
[ext_resource type="Script" path="res://scripts/ui/answer_input_panel.gd" id="6_answer"]

[node name="QuestionHud" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="HudMargin" type="MarginContainer" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 32

[node name="Layout" type="VBoxContainer" parent="Root/HudMargin"]
theme_override_constants/separation = 24

[node name="TopRow" type="HBoxContainer" parent="Root/HudMargin/Layout"]
theme_override_constants/separation = 16

[node name="PhaseBanner" type="PanelContainer" parent="Root/HudMargin/Layout/TopRow"]
script = ExtResource("2_phase")

[node name="PhaseLabel" type="Label" parent="Root/HudMargin/Layout/TopRow/PhaseBanner"]
text = "预热中"

[node name="ShieldIndicator" type="PanelContainer" parent="Root/HudMargin/Layout/TopRow"]
script = ExtResource("3_shield")

[node name="ShieldBody" type="VBoxContainer" parent="Root/HudMargin/Layout/TopRow/ShieldIndicator"]

[node name="ShieldTitle" type="Label" parent="Root/HudMargin/Layout/TopRow/ShieldIndicator/ShieldBody"]
text = "护盾"

[node name="ShieldValue" type="Label" parent="Root/HudMargin/Layout/TopRow/ShieldIndicator/ShieldBody"]
text = "有盾"

[node name="PressureHint" type="Label" parent="Root/HudMargin/Layout/TopRow"]
text = "压力正常"

[node name="Spacer" type="Control" parent="Root/HudMargin/Layout"]
size_flags_vertical = 3

[node name="BottomStack" type="VBoxContainer" parent="Root/HudMargin/Layout"]
theme_override_constants/separation = 16

[node name="JudgementBanner" type="PanelContainer" parent="Root/HudMargin/Layout/BottomStack"]
visible = false
script = ExtResource("4_judgement")

[node name="BannerBody" type="VBoxContainer" parent="Root/HudMargin/Layout/BottomStack/JudgementBanner"]
theme_override_constants/separation = 10

[node name="StatusLabel" type="Label" parent="Root/HudMargin/Layout/BottomStack/JudgementBanner/BannerBody"]
text = "判题中…"

[node name="Actions" type="HBoxContainer" parent="Root/HudMargin/Layout/BottomStack/JudgementBanner/BannerBody"]
theme_override_constants/separation = 12

[node name="RetryJudgementButton" type="Button" parent="Root/HudMargin/Layout/BottomStack/JudgementBanner/BannerBody/Actions"]
text = "重试判题"

[node name="EndRunButton" type="Button" parent="Root/HudMargin/Layout/BottomStack/JudgementBanner/BannerBody/Actions"]
text = "结束本局"

[node name="QuestionPanel" type="PanelContainer" parent="Root/HudMargin/Layout/BottomStack"]
script = ExtResource("5_question")

[node name="QuestionBody" type="VBoxContainer" parent="Root/HudMargin/Layout/BottomStack/QuestionPanel"]
theme_override_constants/separation = 10

[node name="QuestionNumberLabel" type="Label" parent="Root/HudMargin/Layout/BottomStack/QuestionPanel/QuestionBody"]
text = "第 1 / 3 题"

[node name="PromptLabel" type="Label" parent="Root/HudMargin/Layout/BottomStack/QuestionPanel/QuestionBody"]
text = "文档提到的核心玩法是什么？"
autowrap_mode = 3

[node name="TimerLabel" type="Label" parent="Root/HudMargin/Layout/BottomStack/QuestionPanel/QuestionBody"]
text = "剩余 20 秒"

[node name="AnswerInputPanel" type="PanelContainer" parent="Root/HudMargin/Layout/BottomStack"]
script = ExtResource("6_answer")

[node name="AnswerBody" type="VBoxContainer" parent="Root/HudMargin/Layout/BottomStack/AnswerInputPanel"]
theme_override_constants/separation = 10

[node name="AnswerField" type="LineEdit" parent="Root/HudMargin/Layout/BottomStack/AnswerInputPanel/AnswerBody"]
placeholder_text = "输入关键词答案"

[node name="SubmitButton" type="Button" parent="Root/HudMargin/Layout/BottomStack/AnswerInputPanel/AnswerBody"]
text = "提交答案"

[node name="StatusLabel" type="Label" parent="Root/HudMargin/Layout/BottomStack/AnswerInputPanel/AnswerBody"]
text = "输入后按 Enter 提交"
